<?xml version="1.0" encoding="utf-8"?>
<ConfiguracaoClara>
  <Servidor>
    <UrlPublica></UrlPublica>
    <ExecutarMigracoesAutomaticamente>true</ExecutarMigracoesAutomaticamente>
    <MinutosParaConsiderarOffline>3</MinutosParaConsiderarOffline>
  </Servidor>
  <Banco>
    <StringConexaoVariavel>CLARA_POSTGRES</StringConexaoVariavel>
    <NomeBanco>clara</NomeBanco>
    <CriarAutomaticamente>true</CriarAutomaticamente>
  </Banco>
  <Bootstrap>
    <NomeTenant>Clara</NomeTenant>
    <IdentificadorTenant>clara</IdentificadorTenant>
    <NomeAdministrador>Administrador</NomeAdministrador>
    <EmailAdministrador>admin@exemplo.local</EmailAdministrador>
    <SenhaAdministradorVariavel>CLARA_ADMIN_SENHA</SenhaAdministradorVariavel>
  </Bootstrap>
  <Agente>
    <IntervaloHeartbeatSegundos>60</IntervaloHeartbeatSegundos>
    <IntervaloSincronizacaoSegundos>30</IntervaloSincronizacaoSegundos>
    <IntervaloAtualizacaoMinutos>15</IntervaloAtualizacaoMinutos>
    <LimiarOciosidadeMinutos>5</LimiarOciosidadeMinutos>
  </Agente>
</ConfiguracaoClara>
