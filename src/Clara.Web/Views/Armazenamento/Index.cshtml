@* Clara | Programador: Paulo Andrade | Origem: ViewModel/Controller | Destino: interface web | Boas práticas: saída codificada, sem segredos e ações protegidas. *@
@model Clara.Web.Servicos.ConfiguracaoArmazenamentoResumo
@{ ViewData["Title"]="Armazenamento"; }
@if(TempData["Mensagem"] is string m){<div class="mensagem-sucesso">@m</div>}
@if(TempData["Erro"] is string e){<div class="erro">@e</div>}
<section class="cabecalho-pagina cabecalho-clara"><div><span class="sobrelinha">ADMINISTRAÇÃO</span><h1>Armazenamento de evidências</h1><p>O PostgreSQL guarda apenas metadados. Screenshots e outras evidências ficam no provedor escolhido pela Administradora.</p></div><div class="cabecalho-status"><span class="status-pill @(Model.Status=="Ativo"?"status-ok":"status-off")">@Model.Status</span></div></section>
<section class="painel-clara">
<div class="titulo-painel"><div><h2>Destino dos arquivos</h2><p>R2/S3 é o padrão recomendado. O bucket deve permanecer privado; a Clara entrega a imagem somente após autenticação.</p></div></div>
<form method="post" action="/administracao/armazenamento/salvar" class="grade-formulario">@Html.AntiForgeryToken()
<label>Provedor<select name="provedor" id="provedorStorage">
<option value="R2S3" selected="@(Model.Provedor=="R2S3")">Cloudflare R2 / S3 compatível — recomendado</option>
<option value="Local" selected="@(Model.Provedor=="Local")">Disco local — somente homologação/VPS persistente</option>
<option value="SharePoint" selected="@(Model.Provedor=="SharePoint")">SharePoint — conector opcional</option>
<option value="GoogleDrive" selected="@(Model.Provedor=="GoogleDrive")">Google Drive — conector opcional</option>
<option value="HostGatorSftp" selected="@(Model.Provedor=="HostGatorSftp")">HostGator/SFTP — não recomendado para volume de screenshots</option>
</select></label>
<label>Endpoint<input name="endpoint" value="@Model.Endpoint" placeholder="https://ACCOUNT_ID.r2.cloudflarestorage.com" /></label>
<label>Bucket / biblioteca<input name="containerBucket" value="@Model.ContainerBucket" placeholder="clara-evidencias" /></label>
<label>Pasta base<input name="pastaBase" value="@Model.PastaBase" placeholder="clara/evidencias" /></label>
<label>Região<input name="regiao" value="@Model.Regiao" placeholder="auto" /></label>
<label>Access Key ID<input name="accessKeyId" autocomplete="off" placeholder="Deixe vazio para manter a atual" /></label>
<label>Secret Access Key<input name="secretAccessKey" type="password" autocomplete="new-password" placeholder="Deixe vazio para manter a atual" /></label>
<button type="submit">Salvar configuração</button>
</form>
@if(!Model.CofreConfigurado){<div class="aviso-config"><span>!</span><div><strong>Cofre ainda sem chave mestra</strong><small>Configure <code>CLARA_COFRE_MASTER_KEY_BASE64</code> com 32 bytes aleatórios em Base64 no backend antes de salvar credenciais R2/S3.</small></div></div>}
</section>
<section class="painel-clara">
<div class="titulo-painel"><div><h2>Teste do armazenamento</h2><p>A Clara grava um pequeno arquivo privado e o remove em seguida. Nenhuma evidência de usuário é usada no teste.</p></div></div>
<form method="post" action="/administracao/armazenamento/testar">@Html.AntiForgeryToken()<button type="submit">Testar gravação e exclusão</button></form>
@if(Model.UltimoTesteUtc.HasValue){<p class="texto-secundario">Último teste: @Model.UltimoTesteUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</p>}
@if(!string.IsNullOrWhiteSpace(Model.UltimoErro)){<div class="erro">@Model.UltimoErro</div>}
</section>
<section class="nota-evidencias"><span>i</span><div><strong>SharePoint e Google Drive</strong><p>A estrutura já os reconhece como destinos opcionais, mas a ativação exige OAuth corporativo. Eles ficam como conectores posteriores para não transformar o armazenamento básico em uma dependência complexa. HostGator fica disponível apenas como alternativa futura; não será o padrão de screenshots.</p></div></section>
