@* Clara | Programador: Paulo Andrade | Origem: ViewModel/Controller | Destino: interface web | Boas práticas: saída codificada, sem segredos e ações protegidas. *@
@model PainelNavegacaoWeb
@{
    ViewData["Title"] = "Contexto web";
    var dias = (int)(ViewBag.Dias ?? 7);
    var total = Math.Max(1L, Model.Sites.Sum(x => x.Segundos));
    var produtivo = Model.Sites.Where(x => x.Classificacao == "Produtivo").Sum(x => x.Segundos);
    var atencao = Model.Sites.Where(x => x.Classificacao == "Atencao").Sum(x => x.Segundos);
    string Tempo(long segundos) { var t = TimeSpan.FromSeconds(segundos); return t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes:00}m" : $"{Math.Max(1,t.Minutes)}m"; }
    string Classe(string c) => c == "Produtivo" ? "positivo" : c == "Atencao" ? "alerta" : "neutro";
}
@if (TempData["Mensagem"] is string msg) { <div class="mensagem-sucesso">@msg</div> }
<section class="cabecalho-pagina cabecalho-clara">
    <div><span class="sobrelinha">CONTEXTO DIGITAL</span><h1>Navegação web</h1><p>Domínios observados pelo conector autorizado. A Clara não armazena caminho da URL, título, conteúdo, formulário, senha ou texto digitado.</p></div>
    <div class="cabecalho-status"><div class="filtro-periodo"><a class="@(dias==1?"ativo":"")" href="/navegacao-web?dias=1">Hoje</a><a class="@(dias==7?"ativo":"")" href="/navegacao-web?dias=7">7 dias</a><a class="@(dias==30?"ativo":"")" href="/navegacao-web?dias=30">30 dias</a></div></div>
</section>

<section class="cards-indicadores quatro-colunas">
    <a class="card-indicador" href="#" data-drilldown-url="/indicadores/detalhes?tipo=site&dias=@dias"><span class="icone-card azul">◎</span><span>Domínios observados</span><strong>@Model.Sites.Count</strong><small>no período selecionado</small><b>Ver composição →</b></a>
    <a class="card-indicador" href="#" data-drilldown-url="/indicadores/detalhes?tipo=indice&valor=web&dias=@dias"><span class="icone-card verde">▣</span><span>Estações com contexto web</span><strong>@Model.EstacoesComConector</strong><small>com eventos recebidos</small><b>Ver cobertura →</b></a>
    <a class="card-indicador" href="#" data-drilldown-url="/indicadores/detalhes?tipo=site&valor=Produtivo&dias=@dias"><span class="icone-card verde">↗</span><span>Contexto produtivo</span><strong>@Math.Round(produtivo * 100d / total)%</strong><small>do tempo web listado</small><b>Ver domínios →</b></a>
    <a class="card-indicador" href="#" data-drilldown-url="/indicadores/detalhes?tipo=site&valor=Atencao&dias=@dias"><span class="icone-card amarelo">!</span><span>Contexto de atenção</span><strong>@Math.Round(atencao * 100d / total)%</strong><small>do tempo web listado</small><b>Ver domínios →</b></a>
</section>

<section class="painel-clara painel-aplicativos">
    <div class="titulo-painel"><div><span class="sobrelinha">DOMÍNIO + TEMPO</span><h2>Sites mais utilizados</h2><p>Clique no domínio para ver as estações que formaram o indicador. A classificação é definida pelo próprio tenant.</p></div><span class="selo-neutro">Último evento: @(Model.UltimoEventoUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</span></div>
    @if (Model.Sites.Count == 0)
    {
        <div class="estado-vazio"><strong>Nenhum domínio recebido neste período.</strong><span>Ative “Monitorar URLs/domínios”, instale o host nativo e distribua a extensão corporativa do Chrome/Edge.</span></div>
    }
    else
    {
        <div class="lista-apps-detalhada">
        @foreach (var site in Model.Sites)
        {
            var pct = Math.Max(2d, site.Segundos * 100d / total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            <article class="linha-app-detalhada linha-site-detalhada">
                <button type="button" class="app-drilldown" data-drilldown-url="/indicadores/detalhes?tipo=site&valor=@Uri.EscapeDataString(site.Dominio)&dias=@dias">
                    <span class="icone-processo">◎</span>
                    <span class="nome-app"><strong>@site.Dominio</strong><small>@(site.Categoria ?? "Sem categoria") · @site.Estacoes estação(ões)</small></span>
                    <span class="barra-app"><i style="width:@pct%"></i></span>
                    <b>@Tempo(site.Segundos)</b>
                    <span class="selo-classificacao @Classe(site.Classificacao)">@(site.Classificacao == "Atencao" ? "Atenção" : site.Classificacao)</span>
                </button>
                <form method="post" action="/navegacao-web/classificar" class="form-classificar-app form-classificar-site">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dominio" value="@site.Dominio" /><input type="hidden" name="dias" value="@dias" />
                    <select name="classificacao"><option value="Produtivo" selected="@(site.Classificacao=="Produtivo")">Produtivo</option><option value="Neutro" selected="@(site.Classificacao=="Neutro")">Neutro</option><option value="Atencao" selected="@(site.Classificacao=="Atencao")">Atenção</option></select>
                    <input name="categoria" value="@site.Categoria" maxlength="120" placeholder="Categoria" />
                    <button type="submit">Salvar</button>
                </form>
            </article>
        }
        </div>
    }
</section>

@if (Model.Regras.Count > 0)
{
<section class="painel-clara painel-regras-web">
    <div class="titulo-painel"><div><span class="sobrelinha">REGRAS DO TENANT</span><h2>Classificações configuradas</h2></div><span class="selo-neutro">@Model.Regras.Count regra(s)</span></div>
    <div class="tabela-responsiva"><table class="tabela-clara"><thead><tr><th>Domínio</th><th>Categoria</th><th>Classificação</th><th></th></tr></thead><tbody>
    @foreach (var regra in Model.Regras)
    {<tr><td><strong>@regra.Dominio</strong></td><td>@(regra.Categoria ?? "—")</td><td>@(regra.Classificacao == "Atencao" ? "Atenção" : regra.Classificacao)</td><td><form method="post" action="/navegacao-web/regras/@regra.Id/remover">@Html.AntiForgeryToken()<input type="hidden" name="dias" value="@dias"/><button type="submit" class="botao-link">Remover</button></form></td></tr>}
    </tbody></table></div>
</section>
}
<section class="nota-evidencias"><span>i</span><div><strong>Privacidade por desenho</strong><p>A extensão envia somente o host/domínio da aba HTTP(S) ativa e o navegador. Caminho, query string, conteúdo da página, formulários, senhas e texto digitado são descartados antes de chegar ao servidor.</p></div></section>
