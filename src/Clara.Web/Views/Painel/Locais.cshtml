@* Clara | Programador: Paulo Andrade | Origem: ViewModel/Controller | Destino: interface web | Boas práticas: saída codificada, sem segredos e ações protegidas. *@
@model PainelLocais
@{
    ViewData["Title"] = "Home x Escritório";
    string Icone(string codigo)=>codigo switch{"escritorio"=>"▥","home"=>"⌂","externo"=>"▰",_=>"?"};
    string NomeCategoria(string codigo)=>codigo switch{"HomeOffice"=>"Home office com mais ociosidade","OciosidadeAlta"=>"Ociosidade alta","SitesNaoProdutivos"=>"Sites não produtivos","BaixaContinuidade"=>"Baixa continuidade","PossivelNecessidadeTreinamento"=>"Possível necessidade de treinamento","BaixoUsoSistemaPrincipal"=>"Baixo uso do sistema principal",_=>codigo};
}
@if(TempData["Mensagem"] is string msg){<div class="mensagem-sucesso">@msg</div>}
<section class="cabecalho-pagina cabecalho-clara">
    <div><span class="sobrelinha">CONTEXTO DE LOCAL</span><h1>Home x Escritório</h1><p>Compare a produtividade e os padrões de uso por local de trabalho. Estações dentro das redes conhecidas são identificadas automaticamente.</p></div>
    <div class="cabecalho-status"><small>Última atualização: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</small><span class="selo-tempo-real"><i></i>Dados em tempo real</span></div>
</section>

<section class="cards-locais">
@foreach(var r in Model.Resumos){
    <a href="#" class="painel-clara card-local" data-drilldown-url="/indicadores/detalhes?tipo=local&valor=@r.Codigo&dias=30">
        <span class="icone-local">@Icone(r.Codigo)</span><span><strong>@r.Nome</strong><b>@r.Estacoes</b><small>@(r.Estacoes==1?"estação":"estações")</small></span>
        <em class="@(r.Codigo=="escritorio"?"positivo":r.Codigo=="sem"?"neutro":"negativo")">@(r.Codigo=="escritorio"?"↑":"↓") @r.Produtividade%</em><span class="nota-local"><b>@r.Produtividade/100</b><small>média de produtividade</small></span>
    </a>
}
</section>

<section class="grade-locais-principal">
    <article class="painel-clara grafico-locais">
        <div class="titulo-painel"><div><span class="sobrelinha">COMPARATIVO POR LOCAL</span><h2>Produtividade, foco e ociosidade</h2></div></div>
        <div class="grafico-barras-locais">
        @foreach(var r in Model.Resumos){
            <a href="#" class="grupo-barra" data-drilldown-url="/indicadores/detalhes?tipo=local&valor=@r.Codigo&dias=30">
                <div class="barras"><span class="barra produtividade" style="height:@Math.Max(2,r.Produtividade)%"><b>@r.Produtividade%</b></span><span class="barra foco" style="height:@Math.Max(2,r.Foco)%"><b>@r.Foco%</b></span><span class="barra ociosidade" style="height:@Math.Max(2,r.Ociosidade)%"><b>@r.Ociosidade%</b></span></div><strong>@r.Nome</strong>
            </a>
        }
        </div>
        <div class="legenda-grafico"><span><i class="azul"></i>Produtividade</span><span><i class="verde"></i>Foco (tempo produtivo)</span><span><i class="amarelo"></i>Ociosidade</span></div>
    </article>
    <div class="coluna-locais">
        <article class="painel-clara insight-local"><span class="icone-insight">▥</span><div><span class="sobrelinha">INSIGHT PRINCIPAL</span><h2>@Model.InsightPrincipal</h2><p>Com base na média de produtividade e tempo ocioso das estações nos últimos 30 dias.</p></div></article>
        <article class="painel-clara regras-locais"><div class="titulo-painel"><div><span class="sobrelinha">REGRAS ATIVAS</span><h2>Redes conhecidas</h2></div></div><table class="tabela-clara tabela-compacta"><thead><tr><th>Nome</th><th>Faixa de IP/CIDR</th><th>Tipo</th></tr></thead><tbody>@foreach(var r in Model.Regras){<tr><td>@r.Nome</td><td>@r.FaixaIp</td><td>@(r.Tipo=="Escritorio"?"Escritório":r.Tipo=="HomeOffice"?"HomeOffice":r.Tipo)</td></tr>}</tbody></table></article>
    </div>
</section>

<section class="grade-locais-rodape">
    <article class="painel-clara"><div class="titulo-painel"><div><span class="sobrelinha">ESTAÇÕES RECENTES</span><h2>Estações e local identificado automaticamente</h2></div><a href="/estacoes">Ver todas →</a></div><table class="tabela-clara tabela-compacta"><thead><tr><th>Estação</th><th>Usuário</th><th>Local identificado</th><th>IP</th><th>Última comunicação</th></tr></thead><tbody>@foreach(var e in Model.Estacoes.Take(6)){<tr><td><a class="link-forte" href="/estacoes/@e.AtivoId">▣ &nbsp;@e.Hostname</a></td><td>@(e.Responsavel??"—")</td><td>@e.Local</td><td>@(e.EnderecoIpPublico??"—")</td><td>@(e.UltimaComunicacaoUtc?.ToLocalTime().ToString("dd/MM HH:mm:ss")??"—")</td></tr>}</tbody></table></article>
    <article class="painel-clara oportunidades-local"><div class="titulo-painel"><div><span class="sobrelinha">OPORTUNIDADES POR LOCAL</span><h2>Principais insights e recomendações</h2></div></div>
        @if(Model.Oportunidades.Count==0){<p class="texto-secundario">Sem oportunidades específicas por local no período.</p>}
        @foreach(var o in Model.Oportunidades.Take(5)){<a href="#" data-drilldown-url="/indicadores/detalhes?tipo=oportunidade&valor=@o.Categoria&dias=30"><span class="icone-oportunidade">⌂</span><span><strong>@NomeCategoria(o.Categoria)</strong><small>@o.EvidenciaResumida</small></span><b>›</b></a>}
    </article>
</section>

<details class="painel-clara detalhes-colapsados"><summary>Adicionar ou ajustar rede conhecida</summary><form method="post" action="/locais/adicionar" class="grade-formulario">@Html.AntiForgeryToken()<label>Nome<input name="nome" required placeholder="Ex.: Filial Centro" /></label><label>Faixa IP/CIDR<input name="faixaIp" required placeholder="10.20.0.0/16" /></label><label>Tipo<select name="tipo"><option value="Escritorio">Escritório</option><option value="HomeOffice">Home office</option><option value="Externo">Externo</option><option value="Outro">Outro</option></select></label><button type="submit">Adicionar rede</button></form></details>
