@model PainelEvidencias
@{
    ViewData["Title"] = "Evidências";
    var dias=(int)(ViewBag.Dias??1);
    var pessoa=ViewBag.Pessoa as string;
    var categoria=ViewBag.Categoria as string;
    var gravidade=ViewBag.Gravidade as string;
    string Tempo(long segundos){var t=TimeSpan.FromSeconds(Math.Max(0,segundos));return t.TotalHours>=1?$"{(int)t.TotalHours}h {t.Minutes:00}min":$"{t.Minutes}min";}
    string GravidadeNome(string g)=>g switch{"Atencao"=>"Atenção",_=>g};
}
<section class="cabecalho-pagina cabecalho-clara"><div><span class="sobrelinha">VISÃO ANALÍTICA</span><h1>Evidências</h1><p>Registros observados para apoiar a análise de contexto e produtividade.</p></div><div class="cabecalho-status"><small>Última atualização: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</small><span class="selo-tempo-real"><i></i>Dados em tempo real</span></div></section>

<section class="cards-indicadores cinco-colunas cards-evidencias">
    <a href="#" data-drilldown-url="/indicadores/detalhes?tipo=indice&dias=@dias" class="card-indicador"><span class="icone-card verde">▥</span><span>Produtividade observada</span><strong>@Model.ProdutividadeObservada%</strong><small>com base no período atual</small></a>
    <a href="#" data-drilldown-url="/indicadores/detalhes?tipo=evidencia&valor=Ociosidade&dias=@dias" class="card-indicador"><span class="icone-card amarelo">◷</span><span>Períodos ociosos</span><strong>@Model.PeriodosOciosos</strong><small>eventos identificados</small></a>
    <a href="#" data-drilldown-url="/indicadores/detalhes?tipo=evidencia&valor=Acesso%20não%20produtivo&dias=@dias" class="card-indicador"><span class="icone-card vermelho">⊘</span><span>Acessos não produtivos</span><strong>@Model.AcessosNaoProdutivos</strong><small>eventos identificados</small></a>
    <a href="#" data-drilldown-url="/indicadores/detalhes?tipo=aplicativo&valor=ERPDEMO.EXE&dias=@dias" class="card-indicador"><span class="icone-card azul">▣</span><span>Uso do sistema principal</span><strong>@Model.UsoSistemaPrincipal%</strong><small>tempo em apps de negócio</small></a>
    <a href="#" data-drilldown-url="/indicadores/detalhes?tipo=estado&valor=Reunião" class="card-indicador"><span class="icone-card roxo">♧</span><span>Reuniões</span><strong>@Tempo(Model.SegundosReuniaoHoje)</strong><small>tempo total hoje</small></a>
</section>

<form method="get" action="/evidencias" class="painel-clara filtros-evidencias"><label>Período<select name="dias"><option selected="@(dias==1)" value="1">Hoje</option><option selected="@(dias==7)" value="7">Últimos 7 dias</option><option selected="@(dias==30)" value="30">Últimos 30 dias</option></select></label><label>Pessoa<input name="pessoa" value="@pessoa" placeholder="Todos" /></label><label>Categoria<select name="categoria"><option value="">Todas</option>@foreach(var c in Model.Evidencias.Select(x=>x.Categoria).Distinct().OrderBy(x=>x)){<option selected="@(categoria==c)" value="@c">@c</option>}</select></label><label>Gravidade<select name="gravidade"><option value="">Todas</option><option selected="@(gravidade=="Positiva")">Positiva</option><option selected="@(gravidade=="Informativa")">Informativa</option><option selected="@(gravidade=="Atencao")" value="Atencao">Atenção</option><option selected="@(gravidade=="Alta")">Alta</option></select></label><a href="/evidencias">Limpar filtros</a><button type="submit">Aplicar filtros</button></form>

@if(Model.EvidenciasVisuais.Count > 0)
{
<section class="painel-clara painel-evidencias-visuais">
    <div class="titulo-painel"><div><h2>Evidências visuais recentes</h2><p>Capturas autorizadas ajudam a contextualizar o que estava em uso no momento observado.</p></div><span class="selo-demo-visual">@Model.EvidenciasVisuais.Count captura(s)</span></div>
    <div class="grade-evidencias-visuais">
    @foreach(var v in Model.EvidenciasVisuais.Take(8))
    {
        <a class="card-evidencia-visual" href="@v.Url" target="_blank" rel="noopener">
            <span class="miniatura-evidencia"><img src="@v.Url" alt="@v.Titulo" loading="lazy" />@if(v.Demonstrativa){<b>DEMONSTRAÇÃO</b>}</span>
            <span class="meta-evidencia-visual"><strong>@v.Titulo</strong><small>@(v.Pessoa ?? v.Hostname ?? "Ambiente") · @v.CapturadaEmUtc.ToLocalTime().ToString("HH:mm")</small><em>@v.Descricao</em></span>
        </a>
    }
    </div>
    <p class="nota-visual">Capturas demonstrativas são 100% fictícias. Em clientes reais, a coleta visual depende da política de privacidade, perfil de acesso, auditoria, retenção e armazenamento configurados.</p>
</section>
}

<section class="painel-clara painel-evidencias"><div class="titulo-painel"><div><h2>Linha do tempo de evidências</h2><p>Fatos observados no ambiente de trabalho, organizados por horário. Esses registros apoiam a análise e a tomada de decisão gerencial.</p></div><a class="link-botao" href="/evidencias/exportar?dias=@dias&pessoa=@Uri.EscapeDataString(pessoa??string.Empty)&categoria=@Uri.EscapeDataString(categoria??string.Empty)&gravidade=@Uri.EscapeDataString(gravidade??string.Empty)">Exportar CSV⌄</a></div>
    <div class="tabela-responsiva"><table class="tabela-clara tabela-evidencias"><thead><tr><th>Horário</th><th>Pessoa / equipe</th><th>Evidência</th><th>Categoria</th><th>Gravidade</th><th>Fonte</th><th>Ações</th></tr></thead><tbody>
    @foreach(var e in Model.Evidencias){<tr><td><strong>@e.ObservadaEmUtc.ToLocalTime().ToString("HH:mm")</strong></td><td><strong>@(e.Pessoa??e.Equipe??"Ambiente")</strong><small>@e.Equipe</small></td><td><strong>@e.Resumo</strong><small>@e.Detalhe</small></td><td><span class="categoria-pill">@e.Categoria</span></td><td><span class="gravidade-pill @e.Gravidade.ToLowerInvariant()"><i></i>@GravidadeNome(e.Gravidade)</span></td><td>@(e.Hostname??e.Fonte??"—")</td><td><a href="#" data-drilldown-url="/indicadores/detalhes?tipo=evidencia&valor=@Uri.EscapeDataString(e.Categoria)&dias=@dias">•••</a></td></tr>}
    </tbody></table></div>
</section>
<div class="nota-evidencias"><span>i</span><div><strong>Evidências para decisões mais assertivas</strong><p>Esses registros representam fatos observáveis no ambiente de trabalho e devem ser utilizados de forma ética e responsável, como apoio à gestão.</p></div></div>
