@model PainelOportunidades
@{
    ViewData["Title"] = "Oportunidades";
    var dias = (int)(ViewBag.Dias ?? 7);
    var categoriaFiltro = ViewBag.Categoria as string;
    var pessoa = ViewBag.Pessoa as string;
    var impacto = ViewBag.Impacto as string;
    string NomeCategoria(string codigo)=>codigo switch{"OciosidadeAlta"=>"Ociosidade alta","SitesNaoProdutivos"=>"Sites não produtivos","BaixaContinuidade"=>"Baixa continuidade","PossivelNecessidadeTreinamento"=>"Possível necessidade de treinamento","BaixoUsoSistemaPrincipal"=>"Baixo uso de sistema principal","HomeOffice"=>"Oportunidades em home office",_=>codigo};
    string ImpactoNome(string valor)=>valor switch{"Medio"=>"Médio","Baixo"=>"Baixo","Alto"=>"Alto",_=>valor};
    string StatusNome(string valor)=>valor switch{"EmAndamento"=>"Em andamento","Concluida"=>"Concluída",_=>"Pendente"};
}
@if(TempData["Mensagem"] is string msg){<div class="mensagem-sucesso">@msg</div>}
<section class="cabecalho-pagina cabecalho-clara">
    <div><span class="breadcrumb-inline">Inteligência › Oportunidades</span><h1>Oportunidades</h1><p>Padrões observados que merecem atenção e ação para aumentar a produtividade do time.</p></div>
    <div class="cabecalho-status"><small>Última atualização: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</small><a class="botao-secundario" href="/oportunidades/exportar?dias=@dias&categoria=@Uri.EscapeDataString(categoriaFiltro??string.Empty)&pessoa=@Uri.EscapeDataString(pessoa??string.Empty)&impacto=@Uri.EscapeDataString(impacto??string.Empty)">⇩ &nbsp;Exportar CSV</a></div>
</section>

<section class="cards-indicadores cinco-colunas cards-oportunidades">
@foreach(var item in Model.Indicadores){
    var classe = item.Codigo switch{"OciosidadeAlta"=>"amarelo","SitesNaoProdutivos"=>"vermelho","BaixaContinuidade"=>"azul","PossivelNecessidadeTreinamento"=>"roxo",_=>"verde"};
    <a class="card-indicador" href="/oportunidades?dias=@dias&categoria=@item.Codigo" data-drilldown-url="/indicadores/detalhes?tipo=oportunidade&valor=@item.Codigo&dias=@dias"><span class="icone-card @classe">◎</span><span>@item.Titulo</span><strong>@item.Quantidade</strong><small>@item.Complemento</small>@if(item.VariacaoPercentual.HasValue){<em class="variacao @(item.VariacaoPercentual>0?"ruim":"boa")">@(item.VariacaoPercentual>0?"↑":"↓") @Math.Abs(item.VariacaoPercentual.Value)% <i>em relação ao período anterior</i></em>}</a>
}
</section>

<section class="painel-clara painel-oportunidades">
    <div class="barra-filtros-oportunidades">
        <nav class="abas-lista"><a class="@(string.IsNullOrWhiteSpace(categoriaFiltro)&&string.IsNullOrWhiteSpace(pessoa)?"ativo":"")" href="/oportunidades?dias=@dias">Todas as oportunidades (@Model.Total)</a><a class="@(!string.IsNullOrWhiteSpace(categoriaFiltro)?"ativo":"")" href="#filtros">Por categoria</a><a class="@(!string.IsNullOrWhiteSpace(pessoa)?"ativo":"")" href="#filtros">Por pessoa</a></nav>
        <form id="filtros" method="get" action="/oportunidades" class="filtros-inline"><input type="hidden" name="dias" value="@dias" /><input name="pessoa" value="@pessoa" placeholder="⌕  Buscar por pessoa, estação ou evidência..." /><select name="categoria"><option value="">Todas as categorias</option>@foreach(var i in Model.Indicadores){<option selected="@(categoriaFiltro==i.Codigo)" value="@i.Codigo">@i.Titulo</option>}<option selected="@(categoriaFiltro=="HomeOffice")" value="HomeOffice">Home office</option></select><select name="impacto"><option value="">Todos os impactos</option><option selected="@(impacto=="Alto")" value="Alto">Alto</option><option selected="@(impacto=="Medio")" value="Medio">Médio</option><option selected="@(impacto=="Baixo")" value="Baixo">Baixo</option></select><select name="dias"><option selected="@(dias==7)" value="7">Últimos 7 dias</option><option selected="@(dias==30)" value="30">Últimos 30 dias</option><option selected="@(dias==90)" value="90">Últimos 90 dias</option></select><button type="submit" class="botao-secundario">Filtros</button></form>
    </div>
    <div class="tabela-responsiva"><table class="tabela-clara tabela-oportunidades"><thead><tr><th>Pessoa</th><th>Estação</th><th>Categoria</th><th>Evidência resumida</th><th>Impacto</th><th>Recomendação</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach(var o in Model.Oportunidades){
        <tr><td><strong>@(o.Pessoa??o.Equipe??"Equipe")</strong><small>@o.Equipe</small></td><td>@(o.Hostname??"—")</td><td><span class="categoria-pill">◎ &nbsp;@NomeCategoria(o.Categoria)</span></td><td><strong>@o.EvidenciaResumida</strong><small>@o.DetectadaEmUtc.ToLocalTime().ToString("dd/MM HH:mm")</small></td><td><span class="impacto-pill @o.Impacto.ToLowerInvariant()">@ImpactoNome(o.Impacto)</span></td><td>@o.Recomendacao</td><td><span class="status-oportunidade @o.Status.ToLowerInvariant()">@StatusNome(o.Status)</span></td><td><form method="post" action="/oportunidades/@o.Id/status" class="form-status-mini">@Html.AntiForgeryToken()<input type="hidden" name="dias" value="@dias" /><select name="status" aria-label="Alterar status"><option selected="@(o.Status=="Pendente")" value="Pendente">Pendente</option><option selected="@(o.Status=="EmAndamento")" value="EmAndamento">Em andamento</option><option selected="@(o.Status=="Concluida")" value="Concluida">Concluída</option></select><button type="submit">✓</button></form></td></tr>
    }
    </tbody></table></div>
    <footer class="rodape-tabela"><span>Exibindo @Model.Oportunidades.Count de @Model.Total oportunidade(s)</span><span><b>1</b><em>10 por página⌄</em></span></footer>
</section>
