@model SolicitacaoAprovacaoPublica
@{Layout=null;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Aprovação jurídica - Share IT .Clara</title><link rel="stylesheet" href="/css/clara.css"/></head><body class="pagina-aprovacao-juridica"><main class="cartao-aprovacao-juridica"><div class="marca-aprovacao"><img src="/img/logo-clara.png" alt="Share IT .Clara"/></div>
@if(ViewBag.Resultado is string ok){<div class="mensagem-sucesso">@ok</div>}@if(ViewBag.Erro is string erro){<div class="mensagem-erro">@erro</div>}
<span class="sobrelinha">GOVERNANÇA E PRIVACIDADE</span><h1>Aprovação jurídica de recurso</h1><p><strong>Empresa:</strong> @Model.Empresa</p><dl class="resumo-aprovacao"><div><dt>Recurso</dt><dd>@Model.Recurso</dd></div><div><dt>Escopo</dt><dd>@(Model.EscopoDescricao??"Não informado")</dd></div><div><dt>E-mail destinatário</dt><dd>@Model.EmailJuridico</dd></div><div><dt>Documento</dt><dd>@(Model.DocumentoTitulo??"Sem documento vinculado")</dd></div><div><dt>SHA-256</dt><dd><code>@(Model.DocumentoSha256??"—")</code></dd></div><div><dt>Validade solicitada</dt><dd>@Model.ValidadeSolicitadaAte.ToString("dd/MM/yyyy")</dd></div><div><dt>Status</dt><dd>@Model.Status</dd></div></dl>
@if(Model.Status=="Pendente" && Model.ExpiraEmUtc>DateTimeOffset.UtcNow){<form method="post" class="formulario-vertical">@Html.AntiForgeryToken()<label>Nome do responsável jurídico / encarregado<input name="nome" required/></label><label>Cargo / função<input name="cargo" required/></label><label class="declaracao-aprovacao"><input type="checkbox" required/><span>Confirmo que revisei a finalidade, escopo e documento aplicável e possuo autoridade para registrar esta decisão pela empresa.</span></label><div class="acoes-aprovacao"><button type="submit" name="decisao" value="Rejeitar" class="botao-secundario">Rejeitar</button><button type="submit" name="decisao" value="Aprovar">Aprovar</button></div></form>}else{<div class="nota-config">Esta solicitação não está mais disponível para decisão.</div>}
<p class="rodape-aprovacao">A Share IT .Clara registra a decisão, data, e-mail e integridade do documento. A plataforma não substitui a análise jurídica do conteúdo.</p></main></body></html>
