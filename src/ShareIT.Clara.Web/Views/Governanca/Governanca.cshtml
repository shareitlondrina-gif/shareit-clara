@model PainelGovernanca
@{ViewData["Title"]="Governança e Privacidade";}
@if(TempData["Mensagem"] is string msg){<div class="mensagem-sucesso">@msg</div>}
@if(TempData["Erro"] is string err){<div class="mensagem-erro">@err</div>}
@if(TempData["LinkAprovacao"] is string link){<div class="painel link-aprovacao"><strong>Link de aprovação jurídica</strong><input readonly value="@link" id="linkAprovacao"/><button type="button" data-copiar-alvo="linkAprovacao">Copiar link</button><small>Use somente se o transporte de e-mail ainda não estiver configurado.</small></div>}
<section class="cabecalho-pagina"><div><span class="sobrelinha">ADMINISTRAÇÃO</span><h1>Governança e Privacidade</h1>
<p class="aviso-governanca"><strong>Importante:</strong> nesta versão, a aprovação documental não habilita automaticamente captura real de screenshots, visualização ao vivo, gravação de tela, áudio ou webcam. A tela registra a governança necessária para uma futura liberação técnica controlada.</p><p>Documentos, ciência, autorização jurídica e travas para recursos de maior invasividade.</p></div></section>
<section class="grade-governanca-recursos">
@foreach(var recurso in new[]{("Screenshot","Screenshots"),("VisualizacaoAoVivo","Visualização ao vivo"),("GravacaoTela","Gravação de tela"),("Audio","Áudio"),("Webcam","Webcam")}){
  var status=Model.StatusRecursos[recurso.Item1];
  <article class="painel recurso-governanca"><span>@recurso.Item2</span><strong>@status</strong><small>@(status=="Autorização jurídica vigente"?"Documentação aprovada e dentro da validade. A capacidade técnica continua sujeita à versão, política, escopo e controles do produto.":status.StartsWith("Aguardando")?"Aguardando decisão por link/e-mail.":"Desabilitado por padrão. Administrador não libera sozinho.")</small></article>
}
</section>
<section class="grade-governanca">
  <article class="painel"><div class="titulo-painel"><div><h2>1. Registrar documento</h2><p>Política, autorização, RIPD ou comprovante. O sistema armazena o arquivo e SHA-256.</p></div></div><form method="post" enctype="multipart/form-data" action="/administracao/governanca/documentos" class="formulario-vertical">@Html.AntiForgeryToken()<label>Tipo<select name="tipo"><option value="PoliticaMonitoramento">Política de Monitoramento</option><option value="AutorizacaoJuridica">Autorização Jurídica</option><option value="RIPD">RIPD</option><option value="ComprovanteCiencia">Comprovante de ciência</option><option value="Outro">Outro</option></select></label><label>Título<input name="titulo" required/></label><label>Versão<input name="versao" placeholder="1.0"/></label><label>Validade<input type="date" name="validadeAte"/></label><label>Arquivo<input type="file" name="arquivo" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" required/></label><button type="submit">Registrar documento</button></form></article>
  <article class="painel"><div class="titulo-painel"><div><h2>2. Solicitar aprovação jurídica</h2><p>A aprovação não fica nas mãos do administrador ou desenvolvedor.</p></div></div><form method="post" action="/administracao/governanca/solicitar" class="formulario-vertical">@Html.AntiForgeryToken()<label>Documento<select name="documentoId"><option value="">Sem documento vinculado</option>@foreach(var d in Model.Documentos){<option value="@d.Id">@d.Titulo · @d.Sha256[..Math.Min(10,d.Sha256.Length)]…</option>}</select></label><label>Recurso<select name="recurso"><option value="Screenshot">Screenshot</option><option value="VisualizacaoAoVivo">Visualização ao vivo</option><option value="GravacaoTela">Gravação de tela</option><option value="Audio">Áudio</option><option value="Webcam">Webcam</option></select></label><label>Escopo<textarea name="escopoDescricao" rows="3" placeholder="Equipe Financeiro; horário 08:00–18:00; finalidade..."></textarea></label><label>E-mail do Jurídico / Encarregado<input type="email" name="emailJuridico" required/></label><label>Validade solicitada<input type="date" name="validadeAte" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" required/></label><button type="submit">Enviar para aprovação</button></form></article>
  <article class="painel"><div class="titulo-painel"><div><h2>3. Registrar ciência</h2><p>Registra que o colaborador recebeu a política vigente; não substitui a análise jurídica da base legal.</p></div></div><form method="post" action="/administracao/governanca/ciencia" class="formulario-vertical">@Html.AntiForgeryToken()<label>Política/documento<select name="documentoId" required>@foreach(var d in Model.Documentos.Where(x=>x.Tipo=="PoliticaMonitoramento")){<option value="@d.Id">@d.Titulo @(d.Versao is null?"":$"v{d.Versao}")</option>}</select></label><label>Colaborador<input name="colaboradorNome" required/></label><label>E-mail<input type="email" name="colaboradorEmail"/></label><label>Forma de ciência<select name="formaCiencia"><option>RegistroAdministrativo</option><option>E-mail</option><option>AssinaturaDigital</option><option>AssinaturaFisica</option></select></label><label>Observação<textarea name="observacao" rows="2"></textarea></label><button type="submit">Registrar ciência</button></form></article>
  <article class="painel"><div class="titulo-painel"><div><h2>E-mail da plataforma</h2><p>Remetente oficial padrão da .Clara.</p></div></div><div class="email-oficial"><span>De</span><strong>@Model.Email.RemetenteNome &lt;@Model.Email.RemetenteEmail&gt;</strong><small>Transporte SMTP: <b>@(((bool?)(ViewBag.EmailTransporteConfigurado) ?? false) ? "configurado" : "pendente de configuração técnica")</b>. O usuário/senha ficam somente nos segredos do ambiente.</small></div><form method="post" action="/administracao/governanca/email" class="formulario-vertical">@Html.AntiForgeryToken()<label>Reply-To do cliente<input type="email" name="replyTo" value="@Model.Email.ReplyTo" placeholder="rh@cliente.com.br"/></label><label>Destinatários adicionais<input name="destinatariosAdicionais" value="@Model.Email.DestinatariosAdicionais" placeholder="juridico@cliente.com.br, gestor@cliente.com.br"/></label><button type="submit">Salvar e-mail</button></form><hr class="separador-suave"/><form method="post" action="/administracao/governanca/email/teste" class="formulario-vertical">@Html.AntiForgeryToken()<label>Enviar teste para<input type="email" name="destinatarioTeste" placeholder="seuemail@empresa.com.br" required/></label><button type="submit" class="botao-secundario">Enfileirar e-mail de teste</button><small>O envio depende das variáveis SMTP configuradas no ambiente do Render.</small></form></article>
</section>
<section class="painel"><div class="titulo-painel"><div><h2>Documentos registrados</h2><p>O hash permite verificar integridade do arquivo armazenado.</p></div></div><div class="tabela-responsiva"><table><thead><tr><th>Tipo</th><th>Documento</th><th>SHA-256</th><th>Validade</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var d in Model.Documentos){<tr><td>@d.Tipo</td><td><strong>@d.Titulo</strong><span class="subtexto-tabela">@d.NomeArquivo · @(d.TamanhoBytes/1024) KB</span></td><td><code>@d.Sha256[..Math.Min(16,d.Sha256.Length)]…</code></td><td>@(d.ValidadeAte?.ToString("dd/MM/yyyy")??"—")</td><td>@d.StatusValidacao</td><td><a class="link-principal" href="/administracao/governanca/documentos/@d.Id/download">Baixar</a></td></tr>}</tbody></table></div></section>
<section class="painel"><div class="titulo-painel"><div><h2>Solicitações e autorizações</h2><p>Histórico de aprovação jurídica e validade.</p></div></div><div class="tabela-responsiva"><table><thead><tr><th>Recurso</th><th>Jurídico</th><th>Status</th><th>Validade</th><th>Decisão</th></tr></thead><tbody>@foreach(var s in Model.Solicitacoes){<tr><td>@s.Recurso<span class="subtexto-tabela">@s.EscopoDescricao</span></td><td>@s.EmailJuridico</td><td>@s.Status</td><td>@s.ValidadeSolicitadaAte.ToString("dd/MM/yyyy")</td><td>@(s.DecisaoEmUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</td></tr>}</tbody></table></div></section>
<section class="nota-evidencias"><span>i</span><div><strong>Regra de produto</strong><p>Telemetria comportamental é o núcleo normal. Screenshots, live view e gravação exigem governança reforçada. Áudio e webcam permanecem recursos excepcionalíssimos e não são liberados automaticamente por mera configuração administrativa.</p></div></section>
