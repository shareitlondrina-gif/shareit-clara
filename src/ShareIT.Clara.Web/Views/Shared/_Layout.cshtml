@inject RepositorioGovernanca RepositorioGovernanca
@inject RepositorioGestaoExecutiva RepositorioGestaoExecutiva
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var caminho = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var master = User.IsInRole("Master");
    var administrador = User.IsInRole("Administrador");
    var tenantId = User.FindFirst("tenant_id")?.Value;
    var tenantNome = User.FindFirst("tenant_nome")?.Value;
    var empresaNome = User.FindFirst("empresa_nome")?.Value;
    var demonstracao = string.Equals(tenantId, "d0000000-0000-4000-8000-000000000001", StringComparison.OrdinalIgnoreCase);
    var contextoEmpresa = empresaNome ?? tenantNome ?? "Share IT .Clara";
    var visaoIntegrado = false;
    if (autenticado && !master && Guid.TryParse(tenantId, out var tenantGuidLayout))
    {
        try { visaoIntegrado = await RepositorioGestaoExecutiva.VisaoDisponivelAsync(tenantGuidLayout); }
        catch { visaoIntegrado = false; }
    }
    var temaPreferido = Context.Request.Cookies["clara_tema"];
    if (autenticado && Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var usuarioTemaId))
    {
        try { temaPreferido = await RepositorioGovernanca.ObterTemaUsuarioAsync(usuarioTemaId); }
        catch { temaPreferido ??= "Sistema"; }
    }
    temaPreferido ??= "Sistema";
    var temaAtributo = temaPreferido == "Escuro" ? "dark" : temaPreferido == "Claro" ? "light" : "system";
    var corTemaNavegador = temaAtributo == "dark" ? "#111827" : "#f8f5ee";
    if (demonstracao && !contextoEmpresa.Contains("Demonstração", StringComparison.OrdinalIgnoreCase)) contextoEmpresa += " - Demonstração";
    bool Pode(string modulo) => !master && User.HasClaim("modulo", modulo);
    string Ativo(string prefixo) => caminho == prefixo || caminho.StartsWith(prefixo + "/") ? "ativo" : "";
}
<!DOCTYPE html>
<html lang="pt-BR" data-theme="@temaAtributo">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="@corTemaNavegador" />
    <title>@ViewData["Title"] - Share IT .Clara</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon.png" />
    <link rel="icon" href="~/img/favicon.ico" />
    <link rel="manifest" href="~/img/site.webmanifest" />
    <link rel="stylesheet" href="~/css/clara.css" asp-append-version="true" />
</head>
<body class="@(autenticado ? "com-navegacao" : "sem-navegacao")">
@if (autenticado)
{
    <aside class="barra-lateral">
        <a class="marca-lateral" href="@(master ? "/master/empresas" : "/")" aria-label="Share IT .Clara">
            <img src="~/img/logo-clara.png" alt="Share IT .Clara" />
        </a>
        <nav class="menu-principal" aria-label="Navegação principal">
            @if (master)
            {
                <span class="grupo-menu">MASTER</span>
                <a class='@Ativo("/master/empresas")' href="/master/empresas"><span class="icone-menu">▦</span>Administradoras</a>
            }
            else
            {
                @if (Pode("agora") || Pode("estacoes") || Pode("aplicativos"))
                {
                    <span class="grupo-menu">VISÃO</span>
                    @if (Pode("agora")) { <a class="@(caminho == "/" ? "ativo" : "")" href="/"><span class="icone-menu">◉</span>Agora</a> }
                    @if (Pode("estacoes")) { <a class='@Ativo("/estacoes")' href="/estacoes"><span class="icone-menu">▣</span>Estações</a> }
                    @if (Pode("aplicativos")) { <a class='@Ativo("/aplicativos")' href="/aplicativos"><span class="icone-menu">▥</span>Aplicativos</a> }
                }
                @if (Pode("locais") || Pode("integracoes") || (Pode("contexto-ti") && visaoIntegrado))
                {
                    <span class="grupo-menu">CONTEXTO</span>
                    @if (Pode("locais")) { <a class='@Ativo("/locais")' href="/locais"><span class="icone-menu">⌂</span>Home x Escritório</a> }
                    @if (Pode("integracoes")) { <a class='@Ativo("/integracoes")' href="/integracoes"><span class="icone-menu">◇</span>Integrações</a> }
                    @if (Pode("contexto-ti") && visaoIntegrado) { <a class='@Ativo("/contexto-ti")' href="/contexto-ti"><span class="icone-menu">⌁</span>Contexto TI (.VISÃO)</a> }
                }
                @if (Pode("pulso-operacao") || Pode("indice-geral") || Pode("oportunidades") || Pode("evidencias") || Pode("relatorios"))
                {
                    <span class="grupo-menu">INTELIGÊNCIA</span>
                    @if (Pode("pulso-operacao")) { <a class='@Ativo("/pulso-operacao")' href="/pulso-operacao"><span class="icone-menu">◈</span>Pulso da Operação</a> }
                    @if (Pode("indice-geral")) { <a class='@Ativo("/indice-geral")' href="/indice-geral"><span class="icone-menu">◎</span>Índice Geral</a> }
                    @if (Pode("oportunidades")) { <a class='@Ativo("/oportunidades")' href="/oportunidades"><span class="icone-menu">◌</span>Oportunidades</a> }
                    @if (Pode("evidencias")) { <a class='@Ativo("/evidencias")' href="/evidencias"><span class="icone-menu">▧</span>Evidências</a> }
                    @if (Pode("relatorios")) { <a class='@Ativo("/relatorios")' href="/relatorios"><span class="icone-menu">▤</span>Relatórios</a> }
                }
                @if (administrador && (Pode("usuarios") || Pode("perfis") || Pode("configuracoes") || Pode("instalacao-agente") || Pode("alertas") || Pode("governanca")))
                {
                    <span class="grupo-menu">ADMINISTRAÇÃO</span>
                    @if (Pode("usuarios")) { <a class='@Ativo("/administracao/usuarios")' href="/administracao/usuarios"><span class="icone-menu">♙</span>Usuários</a> }
                    @if (Pode("perfis")) { <a class='@Ativo("/administracao/perfis")' href="/administracao/perfis"><span class="icone-menu">☷</span>Perfis</a> }
                    @if (Pode("configuracoes")) { <a class='@Ativo("/administracao/configuracoes")' href="/administracao/configuracoes"><span class="icone-menu">⚙</span>Configurações</a> }
                    @if (Pode("instalacao-agente")) { <a class='@Ativo("/administracao/instalacao")' href="/administracao/instalacao"><span class="icone-menu">⇩</span>Instalação</a> }
                    <a class='@Ativo("/administracao/empresas")' href="/administracao/empresas"><span class="icone-menu">▤</span>Empresas</a>
                    <a class='@Ativo("/administracao/armazenamento")' href="/administracao/armazenamento"><span class="icone-menu">▣</span>Armazenamento</a>
                    @if (Pode("alertas")) { <a class='@Ativo("/administracao/alertas")' href="/administracao/alertas"><span class="icone-menu">!</span>Alertas e regras</a> }
                    @if (Pode("governanca")) { <a class='@Ativo("/administracao/governanca")' href="/administracao/governanca"><span class="icone-menu">◆</span>Governança</a> }
                }
            }
        </nav>
        <div class="rodape-menu">
            @if (!master)
            {
                <div class="empresa-rodape"><strong>@(empresaNome ?? tenantNome)</strong>@if (demonstracao){<small>Ambiente de demonstração</small>}<small>Share IT .Clara v0.6.0</small></div>
            }
            else
            {
                <div class="empresa-rodape"><strong>Share IT .Clara</strong><small>Master da plataforma</small><small>v0.6.0</small></div>
            }
        </div>
    </aside>
}
<div class="estrutura-principal">
    @if (autenticado)
    {
        <header class="topo">
            <div class="contexto-topo">
                @if (master) { <strong>Administração da plataforma</strong> }
                else { <strong>@contextoEmpresa</strong><span>⌄</span> }
            </div>
            <div class="acoes-topo">
                @if (!master)
                {
                    <form method="get" action="/estacoes" class="busca-global">
                        <span>⌕</span><input name="busca" value="@(Context.Request.Query["busca"])" placeholder="Buscar estação, pessoa, patrimônio..." aria-label="Buscar" />
                    </form>
                }
                @if (!master)
                {
                    <button type="button" class="sino-topo" title="Notificações" data-notificacoes-url="/notificacoes/painel" aria-expanded="false">🔔<i data-notificacoes-badge hidden></i></button>
                }
                <div class="menu-usuario-topo">
                    <button type="button" class="perfil-topo" data-menu-usuario-botao aria-expanded="false" aria-haspopup="menu" title="Abrir menu da conta">
                        <img class="avatar-topo avatar-topo-foto" src="/perfil/foto" alt="" />
                        <span class="usuario-topo"><strong>@User.Identity?.Name</strong><small>@(master ? "Master" : administrador ? "Administradora" : "Usuário")</small></span>
                        <span class="seta-topo">⌄</span>
                    </button>
                    <div class="dropdown-usuario" data-menu-usuario hidden role="menu">
                        <div class="dropdown-usuario-cabecalho"><img src="/perfil/foto" alt="" /><div><strong>@User.Identity?.Name</strong><small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value)</small></div></div>
                        <a href="/perfil" role="menuitem"><span>♙</span><div><strong>Perfil</strong><small>Foto, dados pessoais e aparência</small></div></a>
                        <form method="post" action="/sair" role="none">@Html.AntiForgeryToken()<button type="submit" class="acao-sair-dropdown" role="menuitem"><span>↪</span><div><strong>Sair</strong><small>Encerrar esta sessão</small></div></button></form>
                    </div>
                </div>
            </div>
        </header>
    }
    <main class="conteudo">@RenderBody()</main>
</div>


@if (autenticado && !master)
{
    <aside id="painelNotificacoes" class="painel-notificacoes-flutuante" hidden aria-hidden="true"><div class="carregando-modal">Carregando notificações…</div></aside>
}

@if (autenticado && !master)
{
    <div id="modalIndicador" class="modal-indicador" hidden aria-hidden="true">
        <div class="modal-indicador-fundo" data-modal-fechar></div>
        <section class="modal-indicador-caixa" role="dialog" aria-modal="true" aria-labelledby="modalIndicadorTitulo">
            <button type="button" class="modal-fechar" data-modal-fechar aria-label="Fechar">×</button>
            <div id="modalIndicadorConteudo"><div class="carregando-modal">Carregando detalhes…</div></div>
        </section>
    </div>
}
<script src="~/js/clara.js" asp-append-version="true" defer></script>
</body>
</html>
